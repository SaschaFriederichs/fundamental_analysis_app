from PySide6.QtCore import QSize
from PySide6.QtGui import QAction
from PySide6.QtWidgets import QApplication, QMainWindow, QMenuBar, QMenu, QVBoxLayout, QTabWidget, \
    QWidget, QMessageBox, QFileDialog, QLabel, QLineEdit, QHBoxLayout, QPushButton
from .data_extraction import FundamentalAnalysis
from .tab1_gui import FirstCalculation
from .tab2_gui import SecondCalculation
from .tab3_gui import ThirdCalculation
from tab4_gui import ForthCalculation
from tab5_gui import FifthCalculation
from tab6_gui import SixthCalculation
from tab7_gui import SeventhCalculation


# Exit dialog
class ExitDialog(QMessageBox):
    def __init__(self, parent = None):
        super().__init__(parent)
        self.setWindowTitle("Exit Dialog")
        self.setIcon(QMessageBox.Question)
        self.setText("Do you really want to exit?")
        self.setStandardButtons(QMessageBox.Ok | QMessageBox.Cancel)
      
# About dialog      
class AboutDialog(QMessageBox):
    def __init__(self, parent = None):
        super().__init__(parent)
        self.setWindowTitle("About Dialog")
        self.setIcon(QMessageBox.Information)
        self.setText("Fundamental Analysis Tool\nRelease version 0.1\nCopyright Sascha Friederichs 2026")
        self.setStandardButtons(QMessageBox.Close)

# Warning dialog for wrong ticker symbols
class TickerWarningDialog(QMessageBox):
    def __init__(self, parent = None):
        super().__init__(parent)
        self.setWindowTitle("ISIN / Ticker Symbol Error")
        self.setIcon(QMessageBox.Warning)
        self.setText("You must enter a valid ISIN or ticker symbol!")
        self.setStandardButtons(QMessageBox.Close) 
            
# Application main window        
class MainWindow(QMainWindow):
    def __init__(self):
        super().__init__()
        self.file_name = ""
        
        self.setWindowTitle("Funcamental Analysis")
           
        # File menu
        file_menu = QMenu("&File")
        file_menu_load_action = QAction("&Load project", self)
        file_menu_load_action.triggered.connect(self.file_menu_load_action_selected)
        file_menu_save_action = QAction("&Save project", self)
        file_menu_save_action.triggered.connect(self.file_menu_save_action_selected)
        file_menu_save_as_action = QAction("S&ave project as", self)
        file_menu_save_as_action.triggered.connect(self.file_menu_save_as_action_selected)
        file_menu_exit_action = QAction("E&xit", self)                
        file_menu_exit_action.triggered.connect(self.file_menu_exit_action_selected)
        file_menu.addAction(file_menu_load_action)
        file_menu.addAction(file_menu_save_action)
        file_menu.addAction(file_menu_save_as_action)
        file_menu.addSeparator()
        file_menu.addAction(file_menu_exit_action)
        
        #Help menu
        help_menu = QMenu("&Help")
        help_menu_about_action = QAction("&About", self)
        help_menu_about_action.triggered.connect(self.help_menu_about_action_selected)
        help_menu.addAction(help_menu_about_action)
        
        # Menu bar
        main_menu_bar = QMenuBar(self)   
        main_menu_bar.addMenu(file_menu)
        main_menu_bar.addMenu(help_menu)
        
        # Tab widget
        self.first_calculation = FirstCalculation()
        self.second_calculation = SecondCalculation()
        self.third_calculation = ThirdCalculation()
        self.forth_calculation = ForthCalculation()
        self.fifth_calculation = FifthCalculation()  
        self.sixth_calculation = SixthCalculation()
        self.seventh_calculation = SeventhCalculation()
        tabs = QTabWidget()
        tabs.setStyleSheet("QTabBar::tab { min-width: 70px; min-height: 70px; }")
        tabs.setTabPosition(QTabWidget.West)
        tabs.addTab(self.first_calculation, "Revenue\nIncome")
        tabs.addTab(self.second_calculation, "Earnings")
        tabs.addTab(self.third_calculation, "Assets\nLiabilities\nEquity")
        tabs.addTab(self.forth_calculation, "Earnings quality")
        tabs.addTab(self.fifth_calculation, "Profitability\nEfficiency\nFinancial Situation")
        tabs.addTab(self.sixth_calculation, "Evaluation")
        tabs.addTab(self.seventh_calculation, "Evaluation\nManagement eff.\nIntrinsic value")
        
        # Ticker symbol 
        ticker_widget = QWidget()
        ticker_long_name_label = QLabel("Company name")
        self.ticker_long_name_line_edit = QLineEdit()
        self.ticker_long_name_line_edit.setEnabled(False) 
        ticker_label = QLabel("ISIN / Ticker symbol")
        self.ticker_line_edit = QLineEdit() 
        ticker_button = QPushButton("Get Data")
        ticker_button.clicked.connect(self.ticker_button_clicked)
        ticker_layout = QHBoxLayout(ticker_widget)
        ticker_layout.addWidget(ticker_long_name_label, 1)
        ticker_layout.addWidget(self.ticker_long_name_line_edit, 2)
        ticker_layout.addWidget(ticker_label, 1)
        ticker_layout.addWidget(self.ticker_line_edit, 2)
        ticker_layout.addWidget(ticker_button, 1)
        
        # Main layout
        main_widget = QWidget()
        main_layout = QVBoxLayout()
        main_layout.addWidget(main_menu_bar, 1)
        main_layout.addWidget(ticker_widget, 1)
        main_layout.addWidget(tabs, 30)
        main_layout.setContentsMargins(0, 0, 0, 0)
        main_widget.setLayout(main_layout)
        self.setCentralWidget(main_widget)
        self.resize(QSize(800, 1000))
        self.fundamental_analysis = FundamentalAnalysis()
        self.funcamental_analysis_data_available = False
        
    #Event functions
    def file_menu_load_action_selected(self):
        files, filters = QFileDialog.getOpenFileName(self, "Load Project File", "./", "project (*.db)", "*.db")  # @UnusedVariable
        if files != "":
            self.fundamental_analysis.load_financial_data(files)
            self.display_fundamental_data()
            self.file_name = files
            self.ticker_line_edit.setText("")

    def file_menu_save_action_selected(self):
        if self.file_name == "":
            files, filters = QFileDialog.getSaveFileName(self, "Save Project File As", "*/untitled.db", "project (*.db)", "*.db");  # @UnusedVariable
            if files != "":
                self.fundamental_analysis.save_financial_data(files)
                self.file_name = files 
        else:
            self.fundamental_analysis.save_financial_data(self.file_name)       
        
    def file_menu_save_as_action_selected(self):
        files, filters = QFileDialog.getSaveFileName(self, "Save Project File As", "*/untitled.db", "project (*.db)", "*.db");  # @UnusedVariable
        if files != "":
            self.fundamental_analysis.save_financial_data(files)
            self.file_name = files
            
    def file_menu_exit_action_selected(self):  
        dialog = ExitDialog(self)
        if dialog.exec() == QMessageBox.Ok:
            exit()
                
    def help_menu_about_action_selected(self):
        dialog = AboutDialog(self)
        dialog.exec()           
        
    def lastWindowClosed(self):
        self.file_menu_exit_action_selected()
        
    def closeEvent(self, event):
        event.ignore()
        self.file_menu_exit_action_selected()
        
    def ticker_button_clicked(self):
        ticker = self.ticker_line_edit.text()
        if ticker == "":
            dialog = TickerWarningDialog(self)
            dialog.exec()
        else:
            result = self.fundamental_analysis.get_financial_data(ticker)
            if result == False:
                dialog = TickerWarningDialog(self)
                dialog.exec()
                self.funcamental_analysis_data_available = False
            else:
                self.funcamental_analysis_data_available = True
                self.display_fundamental_data()
                self.file_name = ""

    def display_fundamental_data(self):
        # Main window
        self.ticker_long_name_line_edit.setText(self.fundamental_analysis.get_long_name())
        currency = self.fundamental_analysis.get_currency()
        
        # First calculation
        self.first_calculation.set_annual_revenue(self.fundamental_analysis.get_annual_revenue(), currency)
        self.first_calculation.set_annual_net_income(self.fundamental_analysis.get_annual_net_income(), currency)
        self.first_calculation.set_quarterly_revenue(self.fundamental_analysis.get_quarterly_revenue(), currency)
        self.first_calculation.set_quarterly_net_income(self.fundamental_analysis.get_quarterly_net_income(), currency)
        
        # Second calculation
        self.second_calculation.set_gross_profit(self.fundamental_analysis.get_gross_profit(),
            self.fundamental_analysis.get_annual_revenue(), currency)
        self.second_calculation.set_operating_income(self.fundamental_analysis.get_operating_income(),
            self.fundamental_analysis.get_annual_revenue(), currency)
        self.second_calculation.set_net_income(self.fundamental_analysis.get_annual_net_income(),
            self.fundamental_analysis.get_annual_revenue(), currency)
        self.second_calculation.set_earnings_per_share(self.fundamental_analysis.get_earnings_per_share(), currency)
        self.second_calculation.set_earnings_per_share_diluted(self.fundamental_analysis.get_earnings_per_share_diluted(), currency)
        
        # Third calculation
        self.third_calculation.set_liabilities(self.fundamental_analysis.get_total_equity(), 
           self.fundamental_analysis.get_current_liabilities(), 
           self.fundamental_analysis.get_total_non_current_liabilities(), 
           self.fundamental_analysis.get_total_assets(), currency)
        self.third_calculation.set_assets(self.fundamental_analysis.get_cash_and_cash_equivalents(), 
           self.fundamental_analysis.get_accounts_receivable(),
           self.fundamental_analysis.get_other_current_assets(),
           self.fundamental_analysis.get_inventory(), 
           self.fundamental_analysis.get_total_assets(), currency)
        self.third_calculation.set_equity(
           self.fundamental_analysis.get_common_stock(),
           self.fundamental_analysis.get_treasury_stock(),
           self.fundamental_analysis.get_additional_paid_in_capital(),
           self.fundamental_analysis.get_retained_earnings(),
           self.fundamental_analysis.get_stockholders_equity(),
           self.fundamental_analysis.get_minority_interest(),
           self.fundamental_analysis.get_total_equity(),
           self.fundamental_analysis.get_total_assets(),
           currency)
        
        # Forth calculation
        self.forth_calculation.set_market_value(self.fundamental_analysis.get_market_value(), currency)
        self.forth_calculation.set_book_value(self.fundamental_analysis.get_total_equity(), currency)
        self.forth_calculation.set_earnings_quality(
            self.fundamental_analysis.get_operating_cash_flow(),
            self.fundamental_analysis.get_annual_net_income())
        self.forth_calculation.set_free_cashflow(self.fundamental_analysis.get_free_cash_flow(), currency)
        self.forth_calculation.set_cash_burn_rate(self.fundamental_analysis.get_cash_burn_rate())
        
        #Fifth calculation
        self.fifth_calculation.set_return_on_equity(self.fundamental_analysis.get_annual_net_income(), 
           self.fundamental_analysis.get_total_equity())
        self.fifth_calculation.set_return_on_total_capital(
            self.fundamental_analysis.get_ebit(),
            self.fundamental_analysis.get_tax_rate(), 
            self.fundamental_analysis.get_interest_expense(),
            self.fundamental_analysis.get_total_assets())
        self.fifth_calculation.set_employee_productivity(self.fundamental_analysis.get_annual_revenue(), 
           self.fundamental_analysis.get_number_of_employees(), currency)
        self.fifth_calculation.set_days_sales_outstanding(
            self.fundamental_analysis.get_accounts_receivable(), 
            self.fundamental_analysis.get_annual_revenue())
        self.fifth_calculation.set_inventory_turnover_period(
            self.fundamental_analysis.get_inventory(), 
            self.fundamental_analysis.get_cost_of_revenue())
        self.fifth_calculation.set_accounts_payable_turnover_rate(
            self.fundamental_analysis.get_accounts_payable(), 
            self.fundamental_analysis.get_inventory(), 
            self.fundamental_analysis.get_cost_of_revenue())
        self.fifth_calculation.set_debt_to_equity_ratio(
            self.fundamental_analysis.get_current_liabilities(),
            self.fundamental_analysis.get_total_non_current_liabilities(),
            self.fundamental_analysis.get_total_equity())
        self.fifth_calculation.set_current_ratio(
            self.fundamental_analysis.get_current_assets(),
            self.fundamental_analysis.get_current_liabilities())
        self.fifth_calculation.set_quick_ratio(
            self.fundamental_analysis.get_current_assets(), 
            self.fundamental_analysis.get_inventory(), 
            self.fundamental_analysis.get_current_liabilities())
        self.fifth_calculation.set_interest_coverage_ratio(
            self.fundamental_analysis.get_ebit(),
            self.fundamental_analysis.get_interest_expense())
        
        # Sixth calculation
        self.sixth_calculation.set_price_to_book_ratio(
            self.fundamental_analysis.get_current_share_price(),
            self.fundamental_analysis.get_number_shares_outstanding(),
            self.fundamental_analysis.get_total_equity())
        self.sixth_calculation.set_dividend_yield(
            self.fundamental_analysis.get_dividend_yield())
        self.sixth_calculation.set_dividend_payout_ratio(
            self.fundamental_analysis.get_annual_dividend(),
            self.fundamental_analysis.get_earnings_per_share())
        self.sixth_calculation.set_earnings_yield(
            self.fundamental_analysis.get_earnings_per_share(),
            self.fundamental_analysis.get_current_share_price())
        self.sixth_calculation.set_trailing_pe_ratio(
            self.fundamental_analysis.get_earnings_per_share(),
            self.fundamental_analysis.get_current_share_price())
        self.sixth_calculation.set_current_pe_ratio(
            self.fundamental_analysis.get_earnings_per_share(),
            self.fundamental_analysis.get_forward_earnings_per_share(),
            self.fundamental_analysis.get_current_share_price())
        self.sixth_calculation.set_forward_pe_ratio(
            self.fundamental_analysis.get_earnings_per_share(),
            self.fundamental_analysis.get_forward_earnings_per_share(),
            self.fundamental_analysis.get_current_share_price())
        self.sixth_calculation.set_operational_pe_ratio(
            self.fundamental_analysis.get_ebit(),
            self.fundamental_analysis.get_number_shares_outstanding(),
            self.fundamental_analysis.get_current_share_price())
        self.sixth_calculation.set_as_reported_pe_ratio(
            self.fundamental_analysis.get_number_shares_outstanding(),
            self.fundamental_analysis.get_current_share_price(),
            self.fundamental_analysis.get_annual_net_income())
        self.sixth_calculation.set_peg_ratio(
            self.fundamental_analysis.get_peg_ratio())
        
        # Seventh calculation
        self.seventh_calculation.set_total_cash_per_share(
            self.fundamental_analysis.get_number_shares_outstanding(),
            self.fundamental_analysis.get_cash_and_cash_equivalents(),
            self.fundamental_analysis.get_other_short_term_investments(), currency)
        self.seventh_calculation.set_return_on_assets(
            self.fundamental_analysis.get_ebit(),
            self.fundamental_analysis.get_tax_rate(),
            self.fundamental_analysis.get_total_assets())
        self.seventh_calculation.set_share_value_dividend_discount_model(
            self.fundamental_analysis.get_annual_dividend(), 
            self.fundamental_analysis.get_beta(), currency)
        self.seventh_calculation.set_share_value_discounted_cashflow_analysis(
            self.fundamental_analysis.get_beta(),
            self.fundamental_analysis.get_free_cash_flow(),
            self.fundamental_analysis.get_number_shares_outstanding(), currency)

# You need one (and only one) QApplication instance per application.
app = QApplication()

# Create a Qt widget, which will be our window.
window = MainWindow()
window.show()  # IMPORTANT!!!!! Windows are hidden by default.

# Start the event loop.
app.exec()

